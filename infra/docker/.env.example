# Copy to .env (git-ignored) or let scripts/dev-up.ps1 generate it with random secrets.
# NEVER commit real values. CHANGE_ME_* placeholders are rejected by the stack at start-up.
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser
POSTGRES_AUTH_PASSWORD=CHANGE_ME_auth
POSTGRES_CUSTOMER_PASSWORD=CHANGE_ME_customer
POSTGRES_TRANSACTION_PASSWORD=CHANGE_ME_transaction
POSTGRES_RISK_PASSWORD=CHANGE_ME_risk
POSTGRES_NOTIFICATION_PASSWORD=CHANGE_ME_notification
POSTGRES_AUDIT_PASSWORD=CHANGE_ME_audit
POSTGRES_MLFLOW_PASSWORD=CHANGE_ME_mlflow
POSTGRES_EXPORTER_PASSWORD=CHANGE_ME_exporter

# Shared key for /internal/** calls and ml-serving (X-Service-Key)
SERVICE_KEY=CHANGE_ME_service_key_at_least_32_chars

# RS256 key pair for the auth-service (base64 of PEM). Generate with: java scripts/GenKeys.java
JWT_PRIVATE_KEY=CHANGE_ME
JWT_PUBLIC_KEY=CHANGE_ME
JWT_KEY_ID=rp-local-1

# Seed accounts (minimum 12 characters)
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
SEED_ANALYST_PASSWORD=CHANGE_ME_analyst_password

GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana

# Image tag built locally by docker compose
IMAGE_TAG=dev
