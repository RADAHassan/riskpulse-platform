    {
      "id": 123,
      "type": "timeseries",
      "title": "Account lockouts & refresh-token reuse (audit failures proxy)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_server_requests_seconds_count{application=\"auth-service\", uri=\"/api/auth/login\", status=\"423\"}[15m]))",
          "legendFormat": "locked logins",
          "refId": "A",
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_server_requests_seconds_count{application=\"auth-service\", uri=\"/api/auth/refresh\", status=\"401\"}[15m]))",
          "legendFormat": "refresh rejected",
          "refId": "B",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
