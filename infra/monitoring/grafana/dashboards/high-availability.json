{
  "uid": "rp-high-availability",
  "title": "RiskPulse — High availability",
  "description": "Replicas, restarts, disruption budgets and service continuity while pods or nodes are killed.",
  "tags": [
    "riskpulse",
    "ha",
    "kubernetes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
