    {
      "id": 65,
      "type": "timeseries",
      "title": "Gateway success ratio (continuity during chaos)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(rate(http_server_requests_seconds_count{application=\"api-gateway\", status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"api-gateway\"}[1m])))",
          "legendFormat": "",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
