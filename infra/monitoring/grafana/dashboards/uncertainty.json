      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(riskpulse_ml_prediction_uncertainty_bucket[2m]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "instant": false,
          "format": "heatmap"
